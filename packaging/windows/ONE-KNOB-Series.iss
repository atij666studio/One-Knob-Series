; ============================================================================
;  ONE KNOB Series -- combined Windows installer (Inno Setup 6)
;  Tick the plug-ins and formats you want; everything is ticked by default.
;  GENERATED by packaging/windows/generate-iss.py from packaging/plugins.txt.
;  Build (after packaging/build-all.ps1):
;    ISCC.exe /DAppVersion=1.0.0 /DRootDir=<repo> /DStageDir=<repo>\dist\stage /DOutDir=<repo>\dist\release ONE-KNOB-Series.iss
; ============================================================================

#ifndef AppVersion
  #define AppVersion "1.0.0"
#endif
#ifndef StageDir
  #define StageDir "..\..\dist\stage"
#endif
#ifndef OutDir
  #define OutDir "..\..\dist\release"
#endif
#ifndef RootDir
  #define RootDir "..\.."
#endif
#define AppName      "ONE KNOB Series"
#define AppPublisher "ATIJ STUDIO"
#define AppURL       "https://atij666studio.github.io/atijstudio/plugins/one-knob-series/"

[Setup]
AppId={{8E0E4B0B-5D7C-4D2F-9C64-1B8C2F0E7A31}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
VersionInfoVersion={#AppVersion}
VersionInfoCompany={#AppPublisher}
VersionInfoProductName={#AppName}
DefaultDirName={autopf}\{#AppPublisher}\{#AppName}
DisableDirPage=yes
DisableProgramGroupPage=yes
PrivilegesRequired=admin
ArchitecturesInstallIn64BitMode=x64compatible
ArchitecturesAllowed=x64compatible
OutputDir={#OutDir}
OutputBaseFilename=ONE-KNOB-Series-v{#AppVersion}-Windows-x64-Setup
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
WizardSizePercent=120
LicenseFile={#RootDir}\LICENSE
UninstallDisplayName={#AppName} {#AppVersion}
CloseApplications=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
SelectComponentsDesc=Which plug-ins do you want to install?
SelectComponentsLabel2=Tick the plug-ins you want and untick the ones you want to skip. You can run this installer again later to add more.
SelectTasksDesc=Which plug-in formats do you want?
SelectTasksLabel2=Tick the formats your DAW uses. Most DAWs use VST3; Bitwig and Reaper also support CLAP; Ardour and Carla use LV2.

[Types]
Name: "full";   Description: "All 23 plug-ins"
Name: "custom"; Description: "Choose plug-ins"; Flags: iscustom

[Components]
Name: "air"; Description: "AtiNAMatiC-Air  —  Amp-in-the-room air, depth and speaker feel"; Types: full custom
Name: "bloom"; Description: "AtiNAMatiC-Bloom  —  Notes swell and sing as they sustain"; Types: full custom
Name: "boost"; Description: "AtiNAMatiC-Boost  —  Life, punch and clarity into any NAM amp"; Types: full custom
Name: "cab"; Description: "AtiNAMatiC-Cab  —  One-knob speaker cabinet with mic position"; Types: full custom
Name: "choke"; Description: "AtiNAMatiC-Choke  —  Shortens note ring-out for tight stops"; Types: full custom
Name: "cohere"; Description: "AtiNAMatiC-Cohere  —  Tames amp-sim harshness and glues the guitar together"; Types: full custom
Name: "dirt"; Description: "AtiNAMatiC-Dirt  —  Character drive — attitude without full distortion"; Types: full custom
Name: "double"; Description: "AtiNAMatiC-Double  —  Studio-grade double tracking in one knob"; Types: full custom
Name: "feel"; Description: "AtiNAMatiC-Feel  —  Feel enhancer — make everything you play sound better"; Types: full custom
Name: "gate"; Description: "AtiNAMatiC-Gate  —  Intelligent, musical gate for high-gain guitar"; Types: full custom
Name: "hitzone"; Description: "AtiNAMatiC-HitZone  —  Always hit the perfect level for NAM"; Types: full custom
Name: "hum"; Description: "AtiNAMatiC-Hum  —  Removes mains hum and buzz, auto 50/60 Hz"; Types: full custom
Name: "level"; Description: "AtiNAMatiC-Level  —  Auto output leveler — keeps volume consistent"; Types: full custom
Name: "mono"; Description: "AtiNAMatiC-Mono  —  Mono bass, narrow or collapse the stereo image safely"; Types: full custom
Name: "pick"; Description: "AtiNAMatiC-Pick  —  Change how your picking feels — without changing your tone"; Types: full custom
Name: "pitch"; Description: "AtiNAMatiC-Pitch  —  Drop tuning, detune and octave in one knob"; Types: full custom
Name: "reach"; Description: "AtiNAMatiC-Reach  —  Projection and mono-safe stereo spread for amp sims"; Types: full custom
Name: "room"; Description: "AtiNAMatiC-Room  —  Ducking room ambience that stays out of the way"; Types: full custom
Name: "sag"; Description: "AtiNAMatiC-Sag  —  Power-supply sag, bloom and touch response"; Types: full custom
Name: "slow"; Description: "AtiNAMatiC-Slow  —  Auto volume swells on every note"; Types: full custom
Name: "squash"; Description: "AtiNAMatiC-Squash  —  One-knob bus and mix compressor"; Types: full custom
Name: "strum"; Description: "AtiNAMatiC-Strum  —  Three-band strum shaper: string clarity without boom"; Types: full custom
Name: "tight"; Description: "AtiNAMatiC-Tight  —  Instant modern tightness for any tone"; Types: full custom

[Tasks]
Name: "vst3"; Description: "VST3  (C:\Program Files\Common Files\VST3)"
Name: "clap"; Description: "CLAP  (C:\Program Files\Common Files\CLAP)"
Name: "lv2";  Description: "LV2   (C:\Program Files\Common Files\LV2)"

